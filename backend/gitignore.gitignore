# Создано с помощью https://www.toptal.com/developers/gitignore/api/node
# Редактировать на https://www.toptal.com/developers/gitignore?templates=node

### Узел ###
# Журналы
журналы
*.бревно
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Диагностические отчеты (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Данные времени выполнения
ПИДы
*.pid
*.семя
*.pid.lock

# Каталог для инструментированных библиотек, сгенерированных jscoverage/JSCover
lib-cov

# Каталог покрытия, используемый такими инструментами, как Istanbul
покрытие
*.lcov

# охват тестирования в Нью-Йорке
.nyc_output

# Промежуточное хранилище Grunt (https://gruntjs.com/creating-plugins#storing-task-files)
.ворчание

# Каталог зависимостей Bower (https://bower.io/)
bower_components

# конфигурация node-waf
.lock-wscript

# Скомпилированные бинарные дополнения (https://nodejs.org/api/addons.html)
сборка/Выпуск

# Каталоги зависимостей
node_modules/
jspm_packages/

# Каталог зависимостей Snowpack (https://snowpack.dev/)
web_modules/

# Кэш TypeScript
*.tsbuildinfo

# Необязательный каталог кэша npm
.npm

# Дополнительный кэш eslint
.eslintcache

# Дополнительный кэш stylelint
.stylelintcache

# Кэш микропакета
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Необязательная история REPL
.node_repl_history

# Результат выполнения команды 'npm pack'
*.tgz

# Файл целостности пряжи
.yarn-integrity

# Файлы переменных среды dotenv
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# кэш parcel-bundler (https://parceljs.org/)
.cache
.parcel-cache

# Вывод сборки Next.js
.следующий
вне

# Сборка Nuxt.js / генерация выходных данных
.nuxt
дист

# Файлы Гэтсби
.cache/
# Укажите в строке `public`, если ваш проект использует Gatsby, а не Next.js.
# https://nextjs.org/blog/next-9-1#public-directory-support
# публичный

# вывод сборки vuepress
.vuepress/dist

# Временная директория и директория кэша vuepress v2.x
.temp

# Кэш Docusaurus и сгенерированные файлы
.docusaurus

# Бессерверные каталоги
.serverless/

# Кэш блока предохранителей
.fusebox/

# Локальные файлы DynamoDB
.dynamodb/

# Файл порта TernJS
.tern-port

# Сохраняет версии VSCode, используемые для тестирования расширений VSCode
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

### Патч узла ###
# Каталоги Webpack для бессерверных приложений
.webpack/

# Дополнительный кэш stylelint

# Сборка и генерация выходных данных с помощью SvelteKit
.svelte-kit

# Конец https://www.toptal.com/developers/gitignore/api/node